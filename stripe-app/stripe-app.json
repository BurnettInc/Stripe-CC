{
  "$schema": "https://stripe.com/stripe-app.schema.json",
  "id": "com.stripecollectionscopilot.app",
  "name": "CollectionsCopilot",
  "version": "0.1.11",
  "icon": "./icon.png",
  "stripe_api_access_type": "oauth",
  "distribution_type": "public",
  "allowed_redirect_uris": [
    "https://stripe-cc-production.up.railway.app/oauth/callback"
  ],
  "ui_extension": {
    "views": [
      {
        "viewport": "stripe.dashboard.drawer.default",
        "component": "DrawerRootView"
      },
      {
        "viewport": "stripe.dashboard.invoice.detail",
        "component": "InvoiceDetailView"
      }
    ],
    "content_security_policy": {
      "connect-src": [
        "https://stripe-cc-production.up.railway.app/subscription",
        "https://stripe-cc-production.up.railway.app/settings",
        "https://stripe-cc-production.up.railway.app/stripe/connection",
        "https://stripe-cc-production.up.railway.app/billing/checkout",
        "https://stripe-cc-production.up.railway.app/invoices/"
      ],
      "purpose": "Connect to CollectionsCopilot backend for automated invoice follow-ups."
    }
  },
  "extensions": null,
  "permissions": [
    {
      "permission": "invoice_read",
      "purpose": "Reads invoice details (amount, due date, status) so CollectionsCopilot can detect overdue invoices and draft accurate reminder emails."
    },
    {
      "permission": "customer_read",
      "purpose": "Reads customer names and email addresses so reminder emails are addressed correctly and go to the right contact."
    }
  ]
}
