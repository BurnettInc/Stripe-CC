{
  "$schema": "https://stripe.com/stripe-app.schema.json",
  "id": "com.stripecollectionscopilot.app",
  "name": "Stripe Collections Copilot",
  "version": "0.1.6",
  "icon": "./icon.png",
  "stripe_api_access_type": "oauth",
  "distribution_type": "public",
  "allowed_redirect_uris": [
    "https://stripecollectionscopilot.ctonew.app/stripe/oauth/callback"
  ],
  "ui_extension": {
    "views": [
      {
        "viewport": "stripe.dashboard.drawer.default",
        "component": "DrawerRootView"
      },
      {
        "viewport": "stripe.dashboard.invoice.detail",
        "component": "InvoiceDetailView"
      }
    ],
    "content_security_policy": {
      "connect-src": [
        "https://stripecollectionscopilot.ctonew.app/app/"
      ],
      "purpose": "Connect to Stripe Collections Copilot backend for automated invoice follow-ups."
    }
  },
  "extensions": null,
  "permissions": [
    {
      "permission": "invoice_read",
      "purpose": ""
    },
    {
      "permission": "customer_read",
      "purpose": ""
    }
  ]
}
